# Godot 4+ specific ignores
.godot/
/android/

# Временные/черновые файлы (scratch): сама директория закоммичена (маркер
# tmp/.gitignore), содержимое игнорируется.
tmp/*
!tmp/.gitignore

# macOS
.DS_Store

# Logs
*.log
godot*.log

# Godot imported assets
**/*.import
**/*.uid

__pycache__/
*.pyc

# Python venv (functional-тесты; ставится через requirements.txt)
game/addons/venv/

# Node (godot-mcp; ставится через npm install)
node_modules/

# Локальная копия godot-mcp (dev-only, никогда не коммитится)
game/addons/godot-mcp/

# graphify output (graph, wiki, cache)
graphify-out/
