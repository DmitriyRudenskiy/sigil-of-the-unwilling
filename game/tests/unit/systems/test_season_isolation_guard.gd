extends BaseTest

## Гард изоляции сезона (T-322, Q-M130 → (а+в), D-308).
##
## `WorldSeasons._turn_count` — статика процесса. До 2026-11-08 сезон внутри теста
## был функцией порядка прогона: `test_waves_json.gd` и `test_mvp_save.gd`
## оставляли 21 ход, `test_telemetry.gd` — 7, `test_event_router.gd` — 1, и
## производство следующего файла считалось по чужой зиме (замер тикета,
## 2026-10-30). Сброс лежит в `BaseTest` (`_init` на сюиту + `before_test` на
## кейс), а этот файл следит, чтобы сброс не вывалился из носителя: он вызывает
## ровно тот же хук, который вызывает раннер перед каждым кейсом, и требует нуля.
##
## Чего гард НЕ закрывает (дыра решения (а), зафиксирована в `base_test.gd`):
## 94 сюит объявляют собственный `before_test` без `super.before_test()` — внутри
## них кейс по-прежнему читает то, что оставил предыдущий кейс. Гард краснеет,
## если сброс исчезнет из базы; разбирать 94 файлов по одному — путь (в), он не начат.

# Значения, которые production-код оставляет после себя: кампанийный ход
# (`advance_turn`), поднятие мира из сейва (`set_turns`). Порядок перемешан
# намеренно: порядок прогона и есть тот дефект, против которого этот гард пишет.
const LEFTOVERS := [21, 1, 40, 7, 0, 99]


func test_case_boundary_clears_leaked_turn_count() -> void:
	for leftover: int in LEFTOVERS:
		WorldSeasons.set_turns(leftover)  # кейс отработал и забыл про счётчик
		before_test()  # ровно то, что делает раннер перед следующим кейсом
		if WorldSeasons.get_turns() != 0:
			fail("сезон перетёк через границу кейса: после %d осталось %d (T-322)" % [
				leftover, WorldSeasons.get_turns(),
			])
			return


## Сюитный носитель (`BaseTest._init`): файл стартует с нулём, хотя до него по
## порядку прогона идут файлы, поднимающие мир из сейва и гоняющие кампанийный ход.
func test_suite_starts_with_clean_season() -> void:
	assert_that(WorldSeasons.get_turns()).is_equal(0)
