; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sigil of the Unwilling"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7")

[audio]

buses="res://assets/settings/default_bus_layout.tres"

[autoload]

McpInteractionServer="*res://tools/mcp/mcp_interaction_server.gd"
Settings="*res://scripts/autoload/settings.gd"
SoundManager="*res://scripts/autoload/sound_manager.gd"
GameEventBus="*res://scripts/autoload/game_event_bus.gd"
Spellbook="*res://scripts/autoload/spellbook_registry.gd"
PauseController="*res://scripts/autoload/pause_controller.gd"
CursorController="*res://scripts/autoload/cursor_controller.gd"
TemplateBootstrap="*res://scripts/autoload/template_bootstrap.gd"
Units="*res://scripts/autoload/unit_registry.gd"
Artifacts="*res://scripts/autoload/artifact_registry.gd"
Spells="*res://scripts/autoload/spell_registry.gd"
Resources="*res://scripts/autoload/resource_registry.gd"
Services="*res://scripts/autoload/services.gd"
TileAtlasCache="*res://scripts/autoload/tile_atlas_cache.gd"
HexGrid="*res://scripts/autoload/hex_grid.gd"

[config]

features=PackedStringArray("4.7", "GL Compatibility")
icon="res://icon.svg"

[debug]

gdscript/warnings/unused_signal=0
gdscript/warnings/narrowing_conversion=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

plugins="res://addons/gdunit4/plugin.cfg"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdunit4/plugin.cfg")

[gdUnit4]

test_folders="res://tests/"
verbose=false
timeout=300

[gdunit4]

settings/test/test_lookup_folder="tests"

