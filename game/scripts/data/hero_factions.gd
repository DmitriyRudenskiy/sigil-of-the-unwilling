extends RefCounted
class_name HeroFactions
## quests-reputation-system: 6 фракций по расам.
## id совпадает с id расы — родная раса даёт +10 к репутации своей фракции.
const FACTIONS := {
	"human": {
		"name": "Союз Лугов",
		"desc": "Торговцы и ремесленники. Ценят стабильность и честную сделку.",
	},
	"elf": {
		"name": "Лесной Круг",
		"desc": "Стражи лесов. Наказывают охоту без спроса, платят за защиту природы.",
	},
	"dwarf": {
		"name": "Горное Братство",
		"desc": "Кузнецы и рудокопы. Уважают ремесло и крепкое слово.",
	},
	"aumaua": {
		"name": "Морской Дом",
		"desc": "Морские воители. Платят за победы в бою и эскорт по воде.",
	},
	"orlan": {
		"name": "Клятва Орлан",
		"desc": "Кочевые воины. Считают слабость позором, силу — честью.",
	},
	"godlike": {
		"name": "Храм Высших",
		"desc": "Жрецы и мистики. Ценят знание, наказывают кощунство.",
	},
}

static func faction_name(id: String) -> String:
	var f: Dictionary = FACTIONS.get(id, {})
	return str(f.get("name", id))
