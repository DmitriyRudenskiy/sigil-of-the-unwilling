## Слот `Artifact.Slot` для каждой рамки куклы, в порядке DOLL. Слотов в модели
## 12 (`game/scripts/data/artifact.gd:5-9`), рамок в макете 16: рамки 12–15
## остаются пустым декором камня и предмета не показывают никогда (T-242).
const DOLL_SLOTS := [
	&"HEAD", &"NECK", &"TORSO", &"SPELLBOOK", &"WEAPON", &"SHIELD", &"RING_L",
	&"RING_R", &"MISC_A", &"MISC_B", &"LEGS", &"BOOTS",
	&"", &"", &"", &"",
]

## Рамка куклы для слота, -1 — слот ни в одной рамке не показывается. Метки
## `DOLL_SLOTS` — `StringName` с самого появления таблицы (21c2fc4f), а
## `Artifact.Slot` — enum-целое: сравнивать их напрямую бессмысленно (`v is int`
## не срабатывает никогда), поэтому сверка идёт по имени слота.
static func frame_for_slot(slot: Artifact.Slot) -> int:
	var want := String(Artifact.Slot.find_key(slot))
	if want == "":
		return -1
	for i in DOLL_SLOTS.size():
		if String(DOLL_SLOTS[i]) == want:
			return i
	return -1


## Слот рамки куклы — обратная сторона того же порядка, чтобы список надетого и
## кукла не могли разойтись: строка №k и рамка №k обязаны показывать одну вещь.
## Рамки 12–15 — декор камня, у них нет слота (T-242).
static func slot_at_frame(i: int) -> int:
	if i < 0 or i >= DOLL_SLOTS.size():
		return -1
	var want := String(DOLL_SLOTS[i])
	if want == "":
		return -1
	return int(Artifact.Slot.get(want, -1))


## Сетка сумки — одна на всех: GameNumbers.INVENTORY_GRID (50 клеток, D-280).
const GRID_COLS := 10
const GRID_ROWS := 5
const CELL_GAP := 4          # зазор между ячейками, пиксели канвы
const DOLL_SLOTS_N := 16


## Шаг сетки сумки в пикселях канвы: Bag поделён на 10×5, зазор — CELL_GAP.
static func grid_pitch() -> Vector2:
	var b: Rect2 = BLOCKS["Bag"]
	return b.size / Vector2(GRID_COLS, GRID_ROWS)


static func rect(block: String) -> Rect2:
	return BLOCKS[block]


## Доли якорей блока `child` внутри блока `parent` — их пишет генератор сцены,
## чтобы блок тянулся пропорционально окну (позиция — доли, не пиксели).
static func anchor_rect(child: String, parent: String) -> Rect2:
	var p: Rect2 = BLOCKS[parent]
	var c: Rect2 = BLOCKS[child]
	return Rect2(
		c.position / p.size, (c.position + c.size) / p.size)


## То же для произвольного rect'а в координатах канвы (дочерние блоки генератора).
static func anchor_of(child: Rect2, parent: String) -> Rect2:
	var p: Rect2 = BLOCKS[parent]
	return Rect2(child.position / p.size, (child.position + child.size) / p.size)
