; --- токены канона (docs/17-ui-style-guide.md §1.2, значения — [[13-art-bible]] §4.1) ---
; C_BG #281c0f = (0.1569,0.1098,0.0588)      C_BG_DARK #201006 = (0.1255,0.0627,0.0235)
; C_PANEL #4a3423 = (0.2902,0.2039,0.1373)   C_PANEL_BORDER #3a2415 = (0.2275,0.1412,0.0824)
; C_GOLD #8a6a3a = (0.5412,0.4157,0.2275)    C_GOLD_BRIGHT #9e7738 = (0.6196,0.4667,0.2196)
; C_SHADOW #16100a = (0.0863,0.0627,0.0392)  C_SIGN #7a100c = (0.4784,0.0627,0.0471)
; C_INK #090b0e = (0.0353,0.0431,0.0549)
; C_TEXT #e8d5a8 = (0.9098,0.8353,0.6588)    C_TEXT_DIM #d9c48f = (0.8510,0.7686,0.5608)
; C_TEXT_BRIGHT #f5efe0 = (0.9608,0.9373,0.8784)
; Тень — сажа rgba(0,0,0,0.6), offset (0,2), размер 4–8 (§3); радиусы 0 панель/слот, 2 кнопка.

