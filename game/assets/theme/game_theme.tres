; T-147: витрина kitchen_sink. Пять add_theme_stylebox_override брали стиль из темы
; и клали его на узел кодом — переопределение сильнее темы, поэтому кит над этими
; узлами не властен. Переносим сами имена: вариант темы ссылается на тот же
; SubResource, значения не меняются (отсюда нулевая визуальная дельта). Вариант
; обязан быть зарегистрирован с base_type (замер — test_battle_theme_carrier.gd).
PanelWindow/base_type = "PanelContainer"
PanelWindow/styles/panel = SubResource("StyleBoxFlat_window")
