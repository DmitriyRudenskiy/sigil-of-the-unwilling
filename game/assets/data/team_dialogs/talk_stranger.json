      "choices": [
        {"text": "Расскажи о себе.", "tier": "pg", "cond": {}, "effects": [{"bond": 5}], "next": "n2"},
        {"text": "Мне нужны не разговоры, а дела.", "tier": "pg", "cond": {}, "effects": [{"bond": -5, "trust": -5}], "next": "n3"},
        {"text": "Я чувствую, нам суждено вместе. (Хар 4+)", "tier": "pg", "cond": {"min_cha": 4}, "effects": [{"bond": 10}], "next": "n2"}
