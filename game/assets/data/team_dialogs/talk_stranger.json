      "choices": [
        {"text": "Удачи в пути.", "tier": "pg", "cond": {}, "effects": [], "next": null},
        {"text": "Вот, держи на дорогу. (подарок)", "tier": "pg", "cond": {"min_wis": 3}, "effects": [{"item": "gift_small", "bond": 8}], "next": null}
      ]
