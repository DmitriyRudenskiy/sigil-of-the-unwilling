class_name TurnPhaseProcessor
extends RefCounted
## Базовый класс фазы хода (M0: Ядро).
##
## Каждая фаза хода (экономика, демография, город, события) —
## самостоятельный процессор, реализующий этот контракт:
##  - get_phase_id()  — идентификатор фазы (ключ в отчёте хода);
##  - get_priority()  — порядок исполнения (меньше = раньше);
##  - process(ctx)    — обработка фазы, возвращает отчёт (Dictionary).
##
## Процессоры НЕ зависят от узлов Godot и не обращаются к глобальной
## шине: внешние эффекты (UI, GameEventBus) пробрасывает интеграционный
## слой (WorldBootstrap / WorldEventRouter). Это позволяет гонять каждую
## фазу в изолированных headless-тестах.

## Идентификатор фазы (уникальный внутри одного планировщика).
func get_phase_id() -> StringName:
	return &""

## Приоритет исполнения: меньшее значение — раньше.
func get_priority() -> int:
	return 100

## Обработка фазы. Возвращает отчёт (может быть пустым).
func process(_ctx: TurnContext) -> Dictionary:
	return {}
