[gd_scene load_steps=8 format=3 uid="uid://main123"]

[ext_resource type="Script" path="res://scripts/main/main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/managers/game_manager.gd" id="2_gm"]
[ext_resource type="Script" path="res://scripts/managers/ui_manager.gd" id="3_ui"]
[ext_resource type="Script" path="res://scripts/systems/crisis_event_system.gd" id="4_crisis"]
[ext_resource type="Script" path="res://scripts/ui/campaign_hud.gd" id="5_hud"]
[ext_resource type="Script" path="res://scripts/ui/campaign_ui_manager.gd" id="6_uimgr"]

[node name="Main" type="Node"]
script = ExtResource("1_main")

[node name="GameManager" type="Node" parent="."]
script = ExtResource("2_gm")

[node name="UIManager" type="Node" parent="."]
script = ExtResource("3_ui")

; Машина навигации кампании (mvp-ui-flow K-M8): один активный экран, переходы
; по SM. Самих экранов здесь нет — они строятся кодом в носителях, а сюда
; регистрируются (`CampaignHud.bind_city` → `register_screen`).
[node name="CampaignUIManager" type="Node" parent="."]
script = ExtResource("6_uimgr")

[node name="CrisisEventSystem" type="Node" parent="."]
script = ExtResource("4_crisis")

; Слой кампейн-HUD (ui-mockup-parity §7.1, Q-M87 → (б), D-204): носитель экрана
; города в игровом пути. Отдельный CanvasLayer — экран города не зависит от
; кризисных поповеров; дерево строит сам скрипт (конвенция экранов). Дата и
; счётчики макета живут здесь же (7.10/7.11), служебный `DayLabel` снят.
[node name="CampaignHUD" type="CanvasLayer" parent="."]
layer = 5

[node name="CampaignHud" type="Control" parent="CampaignHUD"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 1
script = ExtResource("5_hud")
